# Antigravity Multi-Account Bridge Configuration

# Server bind host and port (default: 127.0.0.1:8090)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8090

# Storage directory for accounts, tokens, and logs
# Default: ~/.antigravity-bridge
# BRIDGE_DATA_DIR=/path/to/custom/dir

# Automatic fallback to Gemini models when Claude/GPT quota is exhausted (true/false)
BRIDGE_AUTO_FALLBACK=true

# Google OAuth App Credentials (Optional if credentials.json is saved to ~/.antigravity-bridge/)
# ANTIGRAVITY_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# ANTIGRAVITY_CLIENT_SECRET=your-google-oauth-client-secret
